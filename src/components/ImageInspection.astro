<dialog id="imageDialog" class="source-dialog image-dialog" tabindex="-1" aria-labelledby="imageTitle">
  <button type="button" class="modal-close" id="imageClose" aria-label="Close image">✕</button>
  <h2 id="imageTitle" dir="auto"></h2>
  <figure class="image-inspection"><img id="inspectedImage" alt="" decoding="async"><p id="imageLoadError" role="status" hidden>Image could not load. Open the original article to view it.</p></figure>
  <a id="imageSourceLink" target="_blank" rel="noopener">View image and credits on the original article</a>
</dialog>

