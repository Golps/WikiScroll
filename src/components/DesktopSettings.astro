---
import Icon from "./Icon.astro";
import DiscoveryControls from "./settings/DiscoveryControls.astro";
import ReadingPreferences from "./settings/ReadingPreferences.astro";
import TravelFilters from "./settings/TravelFilters.astro";
import AboutGestures from "./settings/AboutGestures.astro";
---
<!-- SETTINGS PANEL (desktop) -->
<div class="sp-backdrop" id="spBackdrop"></div>
<div class="sp" id="settingsPanel" role="region" aria-label="Settings">
  <div class="sp-hdr"><span>Settings</span><button class="sp-x" id="spClose" aria-label="Close settings">✕</button></div>

  <div class="sp-section">
    <div class="sp-section-title">Stats</div>
    <div class="sp-row" style="flex-direction:column;align-items:stretch;gap:8px;">
      <div class="streak-display" style="margin-top:4px;">
        <div class="streak-main">
          <span><span class="streak-num" id="dkStreakCount">0</span> <span class="streak-unit">articles today</span></span>
        </div>
        <div class="week-heatmap" id="dkWeekHeatmap"></div>
      </div>
    </div>
    <div class="sp-library-actions" aria-label="Your library">
      <button class="sp-history-action" id="desktopLikesBtn" type="button">
        <span class="sp-row-label"><span class="ico"><Icon name="bookmark" /></span><span><strong>Saved Articles</strong><small>Your personal discovery library</small></span></span>
        <span class="sp-history-arrow" aria-hidden="true">›</span>
      </button>
      <button class="sp-history-action" id="desktopHistoryBtn" type="button">
        <span class="sp-row-label"><span class="ico"><Icon name="clock" /></span><span><strong>History</strong><small>Revisit articles you have discovered</small></span></span>
        <span class="sp-history-arrow" aria-hidden="true">›</span>
      </button>
    </div>
  </div>

  <TravelFilters index={0} />
  <div class="sp-section wikipedia-only">
    <div class="sp-section-title">Discovery</div>

    <DiscoveryControls desktop />
  </div>

  <div class="sp-section">
    <div class="sp-section-title">Reading</div>
    <ReadingPreferences desktop />
  </div>

  <div class="sp-section">
    <div class="sp-section-title">Gestures</div>
    <div class="sp-row">
      <div class="sp-row-label">
        <span class="ico"><Icon name="swipe" /></span>
        <div><div>Swipe Gestures</div><div class="sp-row-sub">Left to skip · Right to save</div></div>
      </div>
      <button class="toggle-sw on" id="dkSwipeToggle" role="switch" aria-label="Toggle swipe gestures"></button>
    </div>

    <div class="sp-row">
      <div class="sp-row-label">
        <span class="ico">⌨️</span>
        <div><div>Show Keyboard Hints</div><div class="sp-row-sub">Navigation bar at the bottom of the screen</div></div>
      </div>
      <button class="toggle-sw on" id="dkKbToggle" role="switch" aria-label="Toggle keyboard hints"></button>
    </div>
  </div>

  <div class="sp-section">
    <div class="sp-section-title">About</div>
    <div class="sp-about">
      <div class="sp-about-logo"><img class="wordmark wordmark-dark" src="/images/wordmark-dark.svg" alt="WikiScroll"><img class="wordmark wordmark-light" src="/images/wordmark-light.svg" alt="WikiScroll"></div>
      <div class="sp-about-body">
        Turn doomscrolling into discovery. Explore unexpected ideas and remarkable places, and leave with something worth knowing.
      </div>
      <AboutGestures desktop />
      <div class="sp-about-contact">contact@wikiscroll.com</div>
      <div class="sp-about-links"><a class="about-link" href="/about/" data-about-link>About WikiScroll</a><button type="button" class="privacy-link-btn" data-open-privacy="settings">Privacy Policy</button><a class="about-link about-link-icon" href="https://github.com/Golps/WikiScroll" target="_blank" rel="noopener" aria-label="Source Code" title="Source Code"><svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg></a></div>
    </div>
  </div>
</div>

