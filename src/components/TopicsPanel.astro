<!-- TOPIC SHEET -->
<div class="sheet-overlay" id="sheetOverlay"></div>
<div class="topic-sheet" id="topicSheet" role="region" aria-label="Topics">
  <div class="sheet-handle"></div>
  <div class="topic-sheet-header"><div class="sheet-title">Topics</div><button class="topic-close" id="topicClose" type="button" aria-label="Close topics"><span class="panel-x" aria-hidden="true">✕</span><span class="panel-done">Done</span></button></div>
  <div class="sheet-sub">Select topics, or leave all off for a random mix.</div>
  <div class="topic-grid" id="topicGrid"></div>
  <button class="sheet-reset" id="sheetReset">Clear all topics</button>
</div>

