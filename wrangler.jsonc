{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wikiscroll",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*", "/collection", "/collection.png"],
    "not_found_handling": "none"
  },
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],
  "ratelimits": [
    {"name":"REQUEST_LIMIT","namespace_id":"2026091701","simple":{"limit":240,"period":60}},
    {"name":"WORK_LIMIT","namespace_id":"2026091702","simple":{"limit":600,"period":60}},
    {"name":"RENDER_LIMIT","namespace_id":"2026091703","simple":{"limit":60,"period":60}}
  ],
  "observability": { "enabled": true },
  // wikiscroll.com is connected in the Cloudflare dashboard; deployments keep it.
  "keep_vars": true
}
