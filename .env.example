# Deployment settings for scripts/deploy.sh. Copy to .env (git-ignored) and fill in.
# Never commit real values. See docs/DEVELOPMENT.md → "Deploying" for token scopes.

# Account API token limited to this Worker (Workers Scripts: Edit on one Worker).
CLOUDFLARE_API_TOKEN=

# Your Cloudflare account ID (Workers & Pages overview → Account details).
CLOUDFLARE_ACCOUNT_ID=

# Optional: path to a Wrangler binary built for your platform, e.g. in a Linux sandbox.
# WRANGLER_BIN=/path/to/node_modules/.bin/wrangler
