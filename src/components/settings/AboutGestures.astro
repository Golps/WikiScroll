---
// The About card's gesture guide: three centred columns, each an animated
// line-art icon over a two-line label. The swipe hands mirror each other.
const { desktop = false } = Astro.props;
const hand = 'M8 13.4V4.6a1.6 1.6 0 0 1 3.2 0v6.2m0-.6a1.6 1.6 0 0 1 3.2 0v1.2m0-.4a1.6 1.6 0 0 1 3.2 0v.8m0 0a1.6 1.6 0 0 1 3.2 0v3.3a6.8 6.8 0 0 1-6.8 6.8h-1.4a5.6 5.6 0 0 1-4.3-2l-3-3.6a1.5 1.5 0 0 1 2.3-1.9L8 15';
const swipeTrack = 'M6.4-.8h11.2M15.8-2.6l1.8 1.8-1.8 1.8';
---
<div class="about-gestures">
  <div class="about-gesture" data-gesture="left">
    <svg class="ag-ico ag-flip" viewBox="0 -3 24 27" aria-hidden="true" focusable="false"><g class="ag-track"><path d={swipeTrack}/></g><g class="ag-move"><path d={hand}/></g></svg>
    <p><strong>Swipe left</strong><span>to skip</span></p>
  </div>
  <div class="about-gesture" data-gesture="right">
    <svg class="ag-ico" viewBox="0 -3 24 27" aria-hidden="true" focusable="false"><g class="ag-track"><path d={swipeTrack}/></g><g class="ag-move"><path d={hand}/></g></svg>
    <p><strong>Swipe right</strong><span>to save</span></p>
  </div>
  {desktop ? (
    <div class="about-gesture" data-gesture="space">
      <svg class="ag-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g class="ag-move"><rect x="1.5" y="7" width="21" height="10" rx="2.6"/><g class="ag-track"><path d="M7 12.6h10"/></g></g></svg>
      <p><strong>Spacebar</strong><span>Ambient Mode</span></p>
    </div>
  ) : (
    <div class="about-gesture" data-gesture="press">
      <svg class="ag-ico" viewBox="0 -1 24 25" aria-hidden="true" focusable="false"><g class="ag-track"><circle cx="9.6" cy="4.6" r="4"/></g><path d={hand}/></svg>
      <p><strong>Long-press</strong><span>Ambient Mode</span></p>
    </div>
  )}
</div>
